<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         backupGlobals="false"
         backupStaticProperties="false"
         bootstrap="bootstrap/autoload.php"
         cacheDirectory="/tmp/.phpunit.cache"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
>
  <testsuites>
    <testsuite name="order">
      <file>./tests/Feature/Console/ShelllessSchedulerTest.php</file>
      <file>./tests/Feature/S3Compatibility/RestoreToRemoteDiskTest.php</file>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <!-- Match CI's memory budget, including commands that set their own PHP limit. -->
    <env name="IMPORT_MEMORY_LIMIT" value="1G"/>
    <env name="LDAP_MEM_LIM" value="1G"/>
    <env name="CACHE_DRIVER" value="array"/>
    <env name="MAIL_FROM_ADDR" value="app@example.com"/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="SYNC_ADAPTERS_LOG_PATH" value="/dev/null"/>
    <env name="LDAP_LOG_PATH" value="/dev/null"/>
    <ini name="memory_limit" value="1G"/>
    <ini name="display_errors" value="true"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">app/</directory>
    </include>
  </source>
</phpunit>
